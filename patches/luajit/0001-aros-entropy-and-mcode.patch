diff -ruN a/src/lj_aros.c b/src/lj_aros.c
--- a/src/lj_aros.c	1970-01-01 01:00:00
+++ b/src/lj_aros.c	2026-11-20 02:02:07
@@ -0,0 +1,53 @@
+/*
+** AROS support: system entropy and executable memory for machine code.
+** Copyright (C) 2005-2026 Mike Pall. See Copyright Notice in luajit.h
+**
+** Kept apart from the rest of the VM: the AROS system headers and LuaJIT
+** both have a type named Node.
+*/
+
+#ifdef __AROS__
+
+#include <stddef.h>
+#include <stdint.h>
+
+#include <exec/memory.h>
+#include <resources/entropy.h>
+#include <proto/exec.h>
+#include <proto/entropy.h>
+
+int lj_aros_entropy(void *buf, size_t len);
+void *lj_aros_mcode_alloc(uintptr_t hint, size_t sz);
+void lj_aros_mcode_free(void *p, size_t sz);
+
+/* Random bytes straight from entropy.resource. Returns 1 on success.
+** Not through getentropy(): that goes through the C library's per-task
+** state, which a thread started by SDL (a plain process, not a pthread) does
+** not have, and every Lua state seeds its PRNG in the thread that creates it.
+*/
+int lj_aros_entropy(void *buf, size_t len)
+{
+  struct Library *EntropyBase = (struct Library *)OpenResource(ENTROPYNAME);
+  if (!EntropyBase)
+    return 0;
+  return GetEntropy(buf, (ULONG)len) == (LONG)len;
+}
+
+/* Memory for machine code. AROS has no mmap, and exec.library cannot be
+** asked for "a block near this address" (AllocAbs() takes one exact address
+** and stopped the system on mainline when given LuaJIT's probe addresses),
+** so the hint is not used. LuaJIT checks whether the block is in range of
+** its code and, if not, starts a new range around the block it got.
+*/
+void *lj_aros_mcode_alloc(uintptr_t hint, size_t sz)
+{
+  (void)hint;
+  return AllocMem(sz, MEMF_EXECUTABLE);
+}
+
+void lj_aros_mcode_free(void *p, size_t sz)
+{
+  FreeMem(p, sz);
+}
+
+#endif
