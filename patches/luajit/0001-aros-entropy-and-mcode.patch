--- a/src/lj_mcode.c	2026-11-19 21:21:11
+++ b/src/lj_mcode.c	2026-11-20 02:02:07
@@ -105,6 +105,33 @@
 #endif
 }
 
+#elif defined(__AROS__)
+
+/* No memory protection to switch: the values only tell the cases apart. */
+#define MCPROT_RW	1
+#define MCPROT_RX	2
+#define MCPROT_RWX	3
+
+/* In lj_aros.c. */
+extern void *lj_aros_mcode_alloc(uintptr_t hint, size_t sz);
+extern void lj_aros_mcode_free(void *p, size_t sz);
+
+static void *mcode_alloc_at(uintptr_t hint, size_t sz, int prot)
+{
+  UNUSED(prot);
+  return lj_aros_mcode_alloc(hint, sz);
+}
+
+static void mcode_free(void *p, size_t sz)
+{
+  lj_aros_mcode_free(p, sz);
+}
+
+static void mcode_setprot(jit_State *J, void *p, size_t sz, int prot)
+{
+  UNUSED(J); UNUSED(p); UNUSED(sz); UNUSED(prot);
+}
+
