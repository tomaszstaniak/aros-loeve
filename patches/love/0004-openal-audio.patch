index ad62aca04d60e0e278734ba7aa2f43093368c6cf..45adc2d60c931f3c9385758d7f01ff7260d5ce5c 100644
--- a/src/common/config.h
+++ b/src/common/config.h
@@ -48,8 +48,7 @@
 #endif
 #if defined(__AROS__)
 #	define LOVE_AROS 1
-// Not built for AROS yet: OpenAL audio output, libmodplug, the network libraries.
-#	define LOVE_NO_OPENAL 1
+// Not built for AROS yet: libmodplug, the network libraries.
 #	define LOVE_NO_MODPLUG 1
 #endif
