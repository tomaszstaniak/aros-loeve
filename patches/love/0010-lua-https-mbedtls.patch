diff --git a/src/libraries/luahttps/src/generic/MbedTLSConnection.cpp b/src/libraries/luahttps/src/generic/MbedTLSConnection.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..9785f79086c40c74e32ca9e4eba4bfdefcb4564c
--- /dev/null
+++ b/src/libraries/luahttps/src/generic/MbedTLSConnection.cpp
@@ -0,0 +1,52 @@
+#include "MbedTLSConnection.h"
+
+#ifdef HTTPS_BACKEND_MBEDTLS
+
+#include <cstdio>
+
+#include "../../../aros/aros_net.h"
+
+MbedTLSConnection::MbedTLSConnection()
+	: tls(nullptr)
+{
+}
+
+MbedTLSConnection::~MbedTLSConnection()
+{
+	close();
+}
+
+bool MbedTLSConnection::valid()
+{
+	return love_aros_tls_usable() != 0;
+}
+
+bool MbedTLSConnection::connect(const std::string &hostname, uint16_t port)
+{
+	char why[240] = "";
+
+	close();
+	tls = love_aros_tls_connect(hostname.c_str(), port, why, sizeof(why));
+	if (!tls)
+		fprintf(stderr, "https: %s\n", why);
+
+	return tls != nullptr;
+}
+
+size_t MbedTLSConnection::read(char *buffer, size_t size)
+{
+	return tls ? love_aros_tls_read(tls, buffer, size) : 0;
+}
+
+size_t MbedTLSConnection::write(const char *buffer, size_t size)
+{
+	return tls ? love_aros_tls_write(tls, buffer, size) : 0;
+}
+
+void MbedTLSConnection::close()
+{
+	love_aros_tls_close(tls);
+	tls = nullptr;
+}
+
+#endif // HTTPS_BACKEND_MBEDTLS
