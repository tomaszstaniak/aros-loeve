+#pragma once
+
+#include "../common/config.h"
+
+#ifdef HTTPS_BACKEND_MBEDTLS
+
+#include "../common/Connection.h"
+
+struct love_aros_tls;
+
+// TLS through Mbed TLS (AROS). The server's certificate is checked against
+// the system's CA bundle and has to name the host.
+class MbedTLSConnection : public Connection
+{
+public:
+	MbedTLSConnection();
+	virtual bool connect(const std::string &hostname, uint16_t port) override;
+	virtual size_t read(char *buffer, size_t size) override;
+	virtual size_t write(const char *buffer, size_t size) override;
+	virtual void close() override;
+	virtual ~MbedTLSConnection();
+
+	static bool valid();
+
+private:
+	love_aros_tls *tls;
+};
+
+#endif // HTTPS_BACKEND_MBEDTLS
