diff --git a/src/libraries/aros/aros_net.c b/src/libraries/aros/aros_net.c
new file mode 100644
index 0000000000000000000000000000000000000000..ee8f1f5441282f140e44257cd8b405bcb53566b4
--- /dev/null
+++ b/src/libraries/aros/aros_net.c
@@ -0,0 +1,306 @@
+/**
+ * TCP and TLS connections on AROS for lua-https. See aros_net.h.
+ **/
+
+#ifdef __AROS__
+
+#include "aros_socket.h"
+#include "aros_net.h"
+
+#include <aros/symbolsets.h>
+#include <dos/dos.h>
+#include <proto/dos.h>
+
+#include <mbedtls/ssl.h>
+#include <mbedtls/entropy.h>
+#include <mbedtls/ctr_drbg.h>
+#include <mbedtls/x509_crt.h>
+#include <psa/crypto.h>
+#include <aros_crypto.h>
+
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+/* The CA bundle of the system. */
+#define LOVE_AROS_CAFILE "ENV:SYS/Certificates/ca-bundle.crt"
+
+int love_aros_tcp_connect(const char *host, unsigned short port)
+{
+	struct addrinfo hints, *addrs = NULL, *addr;
+	char service[8];
+	int fd = -1;
+
+	if (!SocketBase)
+		return -1;
+
+	memset(&hints, 0, sizeof(hints));
+	hints.ai_family = AF_UNSPEC;
+	hints.ai_socktype = SOCK_STREAM;
+	snprintf(service, sizeof(service), "%u", (unsigned) port);
+
+	if (getaddrinfo(host, service, &hints, &addrs) != 0)
+		return -1;
+
+	for (addr = addrs; addr; addr = addr->ai_next)
+	{
+		fd = socket(addr->ai_family, SOCK_STREAM, 0);
+		if (fd < 0)
+			continue;
+		if (connect(fd, addr->ai_addr, addr->ai_addrlen) == 0)
+			break;
+		CloseSocket(fd);
+		fd = -1;
+	}
+
+	freeaddrinfo(addrs);
+	return fd;
+}
+
+size_t love_aros_tcp_read(int fd, char *buffer, size_t size)
+{
+	long n = recv(fd, buffer, size, 0);
+	return n < 0 ? 0 : (size_t) n;
+}
+
+size_t love_aros_tcp_write(int fd, const char *buffer, size_t size)
+{
+	long n = send(fd, (void *) buffer, size, 0);
+	return n < 0 ? 0 : (size_t) n;
+}
+
+void love_aros_tcp_close(int fd)
+{
+	if (fd >= 0)
+		CloseSocket(fd);
+}
+
+struct love_aros_tls
+{
+	int fd;
+	mbedtls_ssl_context ssl;
+	mbedtls_ssl_config conf;
+	mbedtls_x509_crt ca;
+	mbedtls_entropy_context entropy;
+	mbedtls_ctr_drbg_context drbg;
+};
+
+/* Mbed TLS gets its locks before main() and before any thread exists. */
+static int tls_ready;
+
+static int love_aros_tls_init(void)
+{
+	aros_crypto_setup();
+	tls_ready = psa_crypto_init() == PSA_SUCCESS;
+	return 1;
+}
+
+static void love_aros_tls_exit(void)
+{
+	mbedtls_psa_crypto_free();
+	aros_crypto_teardown();
+}
+
+ADD2INIT(love_aros_tls_init, 0);
+ADD2EXIT(love_aros_tls_exit, 0);
+
+int love_aros_tls_usable(void)
+{
+	return tls_ready;
+}
+
+static int bio_send(void *ctx, const unsigned char *buffer, size_t size)
+{
+	struct love_aros_tls *tls = (struct love_aros_tls *) ctx;
+	long n = send(tls->fd, (void *) buffer, size, 0);
+	return n < 0 ? MBEDTLS_ERR_SSL_INTERNAL_ERROR : (int) n;
+}
+
+static int bio_recv(void *ctx, unsigned char *buffer, size_t size)
+{
+	struct love_aros_tls *tls = (struct love_aros_tls *) ctx;
+	long n = recv(tls->fd, buffer, size, 0);
+	return n < 0 ? MBEDTLS_ERR_SSL_INTERNAL_ERROR : (int) n;
+}
+
+/* Mbed TLS's file layer is not in the kit. A bundle with certificates Mbed
+   TLS cannot read is used as long as one could be read: the others are then
+   not trusted. */
+static int load_ca(mbedtls_x509_crt *ca, char *why, size_t whysize)
+{
+	BPTR fh = Open((CONST_STRPTR) LOVE_AROS_CAFILE, MODE_OLDFILE);
+	unsigned char *data;
+	LONG size, got;
+	int r;
+
+	if (!fh)
+	{
+		snprintf(why, whysize, "cannot open the CA bundle %s", LOVE_AROS_CAFILE);
+		return 0;
+	}
+
+	Seek(fh, 0, OFFSET_END);
+	size = Seek(fh, 0, OFFSET_BEGINNING);
+	if (size <= 0 || size > 4 * 1024 * 1024 || !(data = (unsigned char *) malloc((size_t) size + 1)))
+	{
+		Close(fh);
+		snprintf(why, whysize, "the CA bundle %s is empty or too large", LOVE_AROS_CAFILE);
+		return 0;
+	}
+
+	got = Read(fh, data, size);
+	Close(fh);
+	if (got != size)
+	{
+		free(data);
+		snprintf(why, whysize, "cannot read the CA bundle %s", LOVE_AROS_CAFILE);
+		return 0;
+	}
+
+	data[size] = 0;
+	r = mbedtls_x509_crt_parse(ca, data, (size_t) size + 1);
+	free(data);
+	if (r < 0 || ca->version == 0)
+	{
+		snprintf(why, whysize, "no usable certificate in the CA bundle %s", LOVE_AROS_CAFILE);
+		return 0;
+	}
+
+	return 1;
+}
+
+struct love_aros_tls *love_aros_tls_connect(const char *host, unsigned short port, char *why, size_t whysize)
+{
+	static const unsigned char pers[] = "love";
+	struct love_aros_tls *tls;
+	int r;
+
+	if (!tls_ready)
+	{
+		snprintf(why, whysize, "no source of random numbers; TLS is not available");
+		return NULL;
+	}
+
+	tls = (struct love_aros_tls *) calloc(1, sizeof(*tls));
+	if (!tls)
+	{
+		snprintf(why, whysize, "out of memory");
+		return NULL;
+	}
+
+	tls->fd = -1;
+	mbedtls_ssl_init(&tls->ssl);
+	mbedtls_ssl_config_init(&tls->conf);
+	mbedtls_x509_crt_init(&tls->ca);
+	mbedtls_entropy_init(&tls->entropy);
+	mbedtls_ctr_drbg_init(&tls->drbg);
+
+	if (mbedtls_ctr_drbg_seed(&tls->drbg, mbedtls_entropy_func, &tls->entropy, pers, sizeof(pers)) != 0)
+	{
+		snprintf(why, whysize, "no source of random numbers; TLS is not available");
+		goto fail;
+	}
+
+	if (!load_ca(&tls->ca, why, whysize))
+		goto fail;
+
+	if (mbedtls_ssl_config_defaults(&tls->conf, MBEDTLS_SSL_IS_CLIENT, MBEDTLS_SSL_TRANSPORT_STREAM,
+	                                MBEDTLS_SSL_PRESET_DEFAULT) != 0)
+	{
+		snprintf(why, whysize, "TLS setup failed");
+		goto fail;
+	}
+
+	mbedtls_ssl_conf_authmode(&tls->conf, MBEDTLS_SSL_VERIFY_REQUIRED);
+	mbedtls_ssl_conf_ca_chain(&tls->conf, &tls->ca, NULL);
+	mbedtls_ssl_conf_rng(&tls->conf, mbedtls_ctr_drbg_random, &tls->drbg);
+
+	if (mbedtls_ssl_setup(&tls->ssl, &tls->conf) != 0 || mbedtls_ssl_set_hostname(&tls->ssl, host) != 0)
+	{
+		snprintf(why, whysize, "TLS setup failed");
+		goto fail;
+	}
+
+	tls->fd = love_aros_tcp_connect(host, port);
+	if (tls->fd < 0)
+	{
+		snprintf(why, whysize, "cannot connect to %s", host);
+		goto fail;
+	}
+
+	mbedtls_ssl_set_bio(&tls->ssl, tls, bio_send, bio_recv, NULL);
+
+	while ((r = mbedtls_ssl_handshake(&tls->ssl)) != 0)
+	{
+		uint32_t flags;
+
+		if (r == MBEDTLS_ERR_SSL_WANT_READ || r == MBEDTLS_ERR_SSL_WANT_WRITE)
+			continue;
+
+		flags = mbedtls_ssl_get_verify_result(&tls->ssl);
+		if (flags && flags != (uint32_t) -1)
+		{
+			char info[160];
+
+			mbedtls_x509_crt_verify_info(info, sizeof(info), "", flags);
+			info[strcspn(info, "\n")] = 0;
+			snprintf(why, whysize, "certificate of %s refused: %s", host, info);
+		}
+		else
+			snprintf(why, whysize, "TLS handshake with %s failed (-0x%04x)", host, (unsigned) -r);
+		goto fail;
+	}
+
+	return tls;
+
+fail:
+	love_aros_tls_close(tls);
+	return NULL;
+}
+
+size_t love_aros_tls_read(struct love_aros_tls *tls, char *buffer, size_t size)
+{
+	int r;
+
+	for (;;)
+	{
+		r = mbedtls_ssl_read(&tls->ssl, (unsigned char *) buffer, size);
+		if (r == MBEDTLS_ERR_SSL_WANT_READ || r == MBEDTLS_ERR_SSL_WANT_WRITE)
+			continue;
+		/* TLS 1.3 sends session tickets after the handshake; not data. */
+		if (r == MBEDTLS_ERR_SSL_RECEIVED_NEW_SESSION_TICKET)
+			continue;
+		break;
+	}
+
+	return r < 0 ? 0 : (size_t) r;
+}
+
+size_t love_aros_tls_write(struct love_aros_tls *tls, const char *buffer, size_t size)
+{
+	int r;
+
+	do
+		r = mbedtls_ssl_write(&tls->ssl, (const unsigned char *) buffer, size);
+	while (r == MBEDTLS_ERR_SSL_WANT_READ || r == MBEDTLS_ERR_SSL_WANT_WRITE);
+
+	return r < 0 ? 0 : (size_t) r;
+}
+
+void love_aros_tls_close(struct love_aros_tls *tls)
+{
+	if (!tls)
+		return;
+
+	if (tls->fd >= 0)
+		mbedtls_ssl_close_notify(&tls->ssl);
+	mbedtls_ssl_free(&tls->ssl);
+	mbedtls_ssl_config_free(&tls->conf);
+	mbedtls_x509_crt_free(&tls->ca);
+	mbedtls_ctr_drbg_free(&tls->drbg);
+	mbedtls_entropy_free(&tls->entropy);
+	love_aros_tcp_close(tls->fd);
+	free(tls);
+}
+
+#endif /* __AROS__ */
diff --git a/src/libraries/aros/aros_net.h b/src/libraries/aros/aros_net.h
new file mode 100644
index 0000000000000000000000000000000000000000..72816f91ff04b14a8e1d90ac4cb8a067c7700c9c
--- /dev/null
+++ b/src/libraries/aros/aros_net.h
@@ -0,0 +1,46 @@
+/**
+ * TCP and TLS connections on AROS for lua-https.
+ *
+ * Plain connections go through the calling thread's bsdsocket.library base
+ * (aros_socket.h). TLS is Mbed TLS from the aros-crypto kit: the server's
+ * certificate chain is checked against the system's CA bundle and has to
+ * name the host; a connection that cannot be checked is refused.
+ *
+ * A connection belongs to the thread that opened it.
+ **/
+
+#ifndef LOVE_AROS_NET_H
+#define LOVE_AROS_NET_H
+
+#ifdef __AROS__
+
+#include <stddef.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/* A connected socket, or -1. */
+int love_aros_tcp_connect(const char *host, unsigned short port);
+/* Bytes moved; 0 at the end of the stream or on an error. */
+size_t love_aros_tcp_read(int fd, char *buffer, size_t size);
+size_t love_aros_tcp_write(int fd, const char *buffer, size_t size);
+void love_aros_tcp_close(int fd);
+
+struct love_aros_tls;
+
+/* Nonzero when TLS can be used: the random number source works. */
+int love_aros_tls_usable(void);
+/* A checked TLS connection, or NULL with the reason in why. */
+struct love_aros_tls *love_aros_tls_connect(const char *host, unsigned short port, char *why, size_t whysize);
+size_t love_aros_tls_read(struct love_aros_tls *tls, char *buffer, size_t size);
+size_t love_aros_tls_write(struct love_aros_tls *tls, const char *buffer, size_t size);
+void love_aros_tls_close(struct love_aros_tls *tls);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif /* __AROS__ */
+
+#endif /* LOVE_AROS_NET_H */
