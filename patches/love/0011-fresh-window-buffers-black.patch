@@ -166,6 +166,13 @@ class Graphics final : public love::graphics::Graphics
 	StrongRef<love::graphics::Texture> internalBackbufferDepthStencil;
 	GLuint internalBackbufferFBO;
 
+#ifdef LOVE_AROS
+	// Frames for which the system backbuffer is still cleared after a swap.
+	int freshBackbufferFrames = 0;
+	bool freshBackbufferPending = false;
+	void clearSystemBackbuffer();
+#endif
+
 	char *bufferMapMemory;
 	size_t bufferMapMemorySize;
 
