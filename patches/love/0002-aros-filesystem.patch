 // C++17 std::filesystem
@@ -132,6 +134,11 @@ static bool getContainingDirectory(const std::string &path, std::string &newpath
 
 	newpath = path.substr(0, index);
 
+#ifdef LOVE_AROS
+	// "Volume:drawer" is still below the root, which is "Volume:".
+	return !newpath.empty() && newpath.back() != ':';
+#endif
+
 	// Bail if the root has been stripped out.
 	return newpath.find_first_of("/\\") != std::string::npos;
 }
@@ -193,6 +200,19 @@ bool Filesystem::createRealDirectory(const std::string &path)
 
 std::string Filesystem::canonicalizeRealPath(const std::string &p) const
 {
+#ifdef LOVE_AROS
+	// AmigaDOS paths ("Volume:drawer/file", assigns, names relative to the
+	// current drawer) are not what std::filesystem understands. The system
+	// gives the full name of anything that exists; other paths stay as given.
+	BPTR lock = Lock((STRPTR) p.c_str(), SHARED_LOCK);
+	if (lock == BNULL)
+		return p;
+
+	char buffer[2048] = {0};
+	bool ok = NameFromLock(lock, (STRPTR) buffer, sizeof(buffer)) != 0;
+	UnLock(lock);
+	return ok ? std::string(buffer) : p;
+#else
 	try
 	{
 		return std::filesystem::weakly_canonical(p).string();
@@ -201,6 +221,7 @@ std::string Filesystem::canonicalizeRealPath(const std::string &p) const
 	{
 		return p;
 	}
+#endif
 }
 
 std::string Filesystem::getExecutablePath() const
@@ -226,6 +247,21 @@ std::string Filesystem::getExecutablePath() const
 
 	return std::string(buffer, len);
 
+#elif defined(LOVE_AROS)
+
+	// The program's drawer plus the name it was started under.
+	char buffer[2048] = {0};
+	char name[256] = {0};
+
+	if (!NameFromLock(GetProgramDir(), (STRPTR) buffer, sizeof(buffer)))
+		return "";
+	if (!GetProgramName((STRPTR) name, sizeof(name)))
+		return "";
+	if (!AddPart((STRPTR) buffer, FilePart((STRPTR) name), sizeof(buffer)))
+		return "";
+
+	return std::string(buffer);
+
 #else
 #error Missing implementation for Filesystem::getExecutablePath!
 #endif
