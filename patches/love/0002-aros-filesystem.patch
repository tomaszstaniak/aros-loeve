diff --git a/src/libraries/physfs/physfs_platform_aros.c b/src/libraries/physfs/physfs_platform_aros.c
new file mode 100644
index 0000000000000000000000000000000000000000..4ed063af7acfc273f13ca7e245ef0f7a9a488e0f
--- /dev/null
+++ b/src/libraries/physfs/physfs_platform_aros.c
@@ -0,0 +1,86 @@
+/*
+ * AROS support routines for PhysicsFS.
+ *
+ * Files, directories and locks go through the POSIX calls of posixc
+ * (physfs_platform_posix.c). This file supplies the places that have no POSIX
+ * answer on AROS: where the program is, and where a program keeps its files.
+ *
+ * Please see the file LICENSE.txt in the source's root directory.
+ */
+
+#define __PHYSICSFS_INTERNAL__
+#include "physfs_platforms.h"
+
+#ifdef PHYSFS_PLATFORM_AROS
+
+#include <string.h>
+
+#include <proto/dos.h>
+
+#include "physfs_internal.h"
+
+int __PHYSFS_platformInit(void)
+{
+    return 1;  /* always succeed. */
+} /* __PHYSFS_platformInit */
+
+
+void __PHYSFS_platformDeinit(void)
+{
+    /* no-op */
+} /* __PHYSFS_platformDeinit */
+
+
+void __PHYSFS_platformDetectAvailableCDs(PHYSFS_StringCallback cb, void *data)
+{
+    /* no-op: volumes are not listed. */
+} /* __PHYSFS_platformDetectAvailableCDs */
+
+
+/* A copy of an AmigaDOS path that further names can be appended to: it ends
+   in ':' (a volume or assign) or in '/'. */
+static char *dirWithSeparator(const char *path)
+{
+    const size_t len = strlen(path);
+    char *retval = (char *) allocator.Malloc(len + 2);
+    BAIL_IF(!retval, PHYSFS_ERR_OUT_OF_MEMORY, NULL);
+    strcpy(retval, path);
+    if ((len > 0) && (retval[len - 1] != ':') && (retval[len - 1] != '/'))
+    {
+        retval[len] = '/';
+        retval[len + 1] = '\0';
+    } /* if */
+    return retval;
+} /* dirWithSeparator */
+
+
+char *__PHYSFS_platformCalcBaseDir(const char *argv0)
+{
+    char buf[1024];
+    BAIL_IF(!NameFromLock(GetProgramDir(), (STRPTR) buf, sizeof (buf)),
+            PHYSFS_ERR_OS_ERROR, NULL);
+    return dirWithSeparator(buf);
+} /* __PHYSFS_platformCalcBaseDir */
+
+
+char *__PHYSFS_platformCalcUserDir(void)
+{
+    /* AROS has no per-user home directory: the system volume stands in. */
+    return dirWithSeparator("SYS:");
+} /* __PHYSFS_platformCalcUserDir */
+
+
+char *__PHYSFS_platformCalcPrefDir(const char *org, const char *app)
+{
+    /* Programs keep their own files in a drawer of ENVARC:. */
+    const char *base = "ENVARC:";
+    const size_t len = strlen(base) + strlen(app) + 2;
+    char *retval = (char *) allocator.Malloc(len);
+    BAIL_IF(!retval, PHYSFS_ERR_OUT_OF_MEMORY, NULL);
+    snprintf(retval, len, "%s%s/", base, app);
+    return retval;
+} /* __PHYSFS_platformCalcPrefDir */
+
+#endif /* PHYSFS_PLATFORM_AROS */
+
+/* end of physfs_platform_aros.c ... */
