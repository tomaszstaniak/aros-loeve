+ * 1. The origin of this software must not be misrepresented; you must not
+ *    claim that you wrote the original software. If you use this software
+ *    in a product, an acknowledgment in the product documentation would be
+ *    appreciated but is not required.
+ * 2. Altered source versions must be plainly marked as such, and must not be
+ *    misrepresented as being the original software.
+ * 3. This notice may not be removed or altered from any source distribution.
+ **/
+
+/*
+ * AROS: run the program on a stack of at least __stack bytes.
+ *
+ * A Shell start runs the program on the Shell's stack, a Workbench start on
+ * the icon's; both are far too small for Lua, the shader compiler and the
+ * image decoders. Not every AROS start-up code swaps to __stack itself. This
+ * entry sits in the start-up chain after detaching and before the C library
+ * set-up and main(), so exit() from anywhere comes back here and the stack is
+ * freed. Where the stack is already large enough it only continues the chain.
+ */
+
+#include <aros/startup.h>
+#include <aros/symbolsets.h>
+#include <exec/memory.h>
+#include <exec/tasks.h>
+#include <proto/exec.h>
+
+/* Start-up code that swaps stacks itself reads this too. */
+unsigned long __stack = 8 * 1024 * 1024;
+
+static void love_stack(struct ExecBase *SysBase)
+{
+	struct Task *me = FindTask(NULL);
+	IPTR want = ((IPTR) __stack + 15) & ~(IPTR) 15;
+	IPTR have = (IPTR) me->tc_SPUpper - (IPTR) me->tc_SPLower;
+	struct StackSwapStruct sss;
+	struct StackSwapArgs args = { { 0 } };
+	UBYTE *stack;
+
+	if (want <= have || !(stack = AllocMem(want, MEMF_ANY)))
+	{
+		__startup_entries_next();
+		return;
+	}
+
+	sss.stk_Lower = stack;
+	sss.stk_Upper = stack + want;
+	sss.stk_Pointer = sss.stk_Upper;
+	args.Args[0] = (IPTR) SysBase;
+	NewStackSwap(&sss, (APTR) ___startup_entries_next, &args);
+	FreeMem(stack, want);
+}
+
+ADD2SET(love_stack, PROGRAM_ENTRIES, -60);
