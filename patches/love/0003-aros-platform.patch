diff --git a/src/modules/sensor/sdl/Sensor.cpp b/src/modules/sensor/sdl/Sensor.cpp
index 7d4bac12d4452b16b86981017ffc9f4ab9b347e2..e94912a350cc84c223e94dfc80aea06721714f9a 100644
--- a/src/modules/sensor/sdl/Sensor.cpp
+++ b/src/modules/sensor/sdl/Sensor.cpp
@@ -36,12 +36,22 @@ Sensor::Sensor()
 	: love::sensor::Sensor("love.sensor.sdl")
 	, sensors()
 {
+#ifdef LOVE_AROS
+	// SDL for AROS has no sensor support. The module still loads, as games
+	// expect it to: it reports that no sensor is available.
+	sensorsInitialized = SDL_InitSubSystem(SDL_INIT_SENSOR);
+#else
 	if (!SDL_InitSubSystem(SDL_INIT_SENSOR))
 		throw love::Exception("Could not initialize SDL sensor subsystem (%s)", SDL_GetError());
+#endif
 }
 
 Sensor::~Sensor()
 {
+#ifdef LOVE_AROS
+	if (!sensorsInitialized)
+		return;
+#endif
 	SDL_QuitSubSystem(SDL_INIT_SENSOR);
 }
 
