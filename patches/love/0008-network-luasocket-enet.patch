diff --git a/src/libraries/aros/aros_socket.c b/src/libraries/aros/aros_socket.c
new file mode 100644
index 0000000000000000000000000000000000000000..892400c6370a8da4e6ff0f76e67d30cbfcd7ed98
--- /dev/null
+++ b/src/libraries/aros/aros_socket.c
@@ -0,0 +1,102 @@
+/**
+ * Sockets on AROS: one bsdsocket.library base per thread. See aros_socket.h.
+ **/
+
+#ifdef __AROS__
+
+#include <exec/types.h>
+#include <exec/libraries.h>
+#include <utility/tagitem.h>
+#include <proto/exec.h>
+
+#include <stdlib.h>
+
+#include <SDL3/SDL.h>
+
+struct love_aros_net
+{
+	struct Library *base;
+	int err;
+	LONG herr;
+};
+
+/* The library calls below go through this file's own variable. */
+#define SocketBase (net->base)
+#include <proto/bsdsocket.h>
+#include <bsdsocket/socketbasetags.h>
+
+static SDL_TLSID tls;
+static SDL_AtomicInt exit_hook;
+
+static void net_free(void *value)
+{
+	struct love_aros_net *net = (struct love_aros_net *) value;
+
+	if (net->base)
+		CloseLibrary(net->base);
+	SDL_free(net);
+}
+
+/* The main thread's base, if SDL has not released it by the time the
+   program ends. */
+static void net_at_exit(void)
+{
+	struct love_aros_net *net = (struct love_aros_net *) SDL_GetTLS(&tls);
+
+	if (net && net->base)
+	{
+		CloseLibrary(net->base);
+		net->base = NULL;
+	}
+}
+
+static struct love_aros_net *net_state(void)
+{
+	static struct love_aros_net none;
+	struct love_aros_net *net = (struct love_aros_net *) SDL_GetTLS(&tls);
+
+	if (net)
+		return net;
+
+	net = (struct love_aros_net *) SDL_calloc(1, sizeof(*net));
+	if (!net)
+		return &none;
+
+	net->base = OpenLibrary((CONST_STRPTR) "bsdsocket.library", 4);
+	if (net->base)
+	{
+		SocketBaseTags(
+			SBTM_SETVAL(SBTC_ERRNOPTR(sizeof(net->err))), (IPTR) &net->err,
+			SBTM_SETVAL(SBTC_HERRNOLONGPTR), (IPTR) &net->herr,
+			TAG_DONE);
+	}
+
+	if (!SDL_SetTLS(&tls, net, net_free))
+	{
+		net_free(net);
+		return &none;
+	}
+
+	if (SDL_CompareAndSwapAtomicInt(&exit_hook, 0, 1))
+		atexit(net_at_exit);
+
+	return net;
+}
+
+struct Library *love_aros_socket_base(void)
+{
+	return net_state()->base;
+}
+
+int *love_aros_socket_errno(void)
+{
+	return &net_state()->err;
+}
+
+int *love_aros_socket_herrno(void)
+{
+	/* LONG and int are both 32 bits wide on AROS. */
+	return (int *) &net_state()->herr;
+}
+
+#endif /* __AROS__ */
diff --git a/src/libraries/aros/aros_socket.h b/src/libraries/aros/aros_socket.h
new file mode 100644
index 0000000000000000000000000000000000000000..f7db6d6791f397c08d71ee9f6fb0202f78b84d07
--- /dev/null
+++ b/src/libraries/aros/aros_socket.h
@@ -0,0 +1,83 @@
+/**
+ * Sockets on AROS for the bundled network libraries (LuaSocket, ENet).
+ *
+ * AROS has no socket calls in its C library. They are functions of
+ * bsdsocket.library, called through a library base that belongs to the task
+ * which opened it; a socket is usable only through the base it was made
+ * with. This header gives the BSD names (socket, connect, recv, ...) as calls
+ * through the calling thread's own base, and errno/h_errno as that base's
+ * error variables.
+ *
+ * Include it after the system's socket headers. A thread's sockets cannot be
+ * used by another thread.
+ **/
+
+#ifndef LOVE_AROS_SOCKET_H
+#define LOVE_AROS_SOCKET_H
+
+#ifdef __AROS__
+
+/* getaddrinfo, getnameinfo, inet_pton and inet_ntop of bsdsocket.library are
+   declared only with this set, and <netdb.h> reads the declarations: it has
+   to be set for the whole file (the build does that). */
+#ifndef __CONFIG_ROADSHOW__
+#error "build this file with -D__CONFIG_ROADSHOW__"
+#endif
+
+#include "aros_endian.h"
+
+#include <sys/types.h>
+#include <sys/time.h>
+#include <sys/socket.h>
+#include <sys/ioctl.h>
+#include <netinet/in.h>
+#include <netinet/tcp.h>
+#include <arpa/inet.h>
+#include <netdb.h>
+#include <errno.h>
+
+#include <exec/types.h>
+#include <exec/libraries.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/* The calling thread's bsdsocket.library base, opened on first use and
+   closed when the thread ends. NULL when there is no network stack. */
+struct Library *love_aros_socket_base(void);
+
+/* The error variables bsdsocket.library fills for the calling thread. */
+int *love_aros_socket_errno(void);
+int *love_aros_socket_herrno(void);
+
+#ifdef __cplusplus
+}
+#endif
+
+#define SocketBase love_aros_socket_base()
+#include <proto/bsdsocket.h>
+
+/* <arpa/inet.h> renames these to C library functions that AROS does not
+   have; they are bsdsocket.library calls like the rest. */
+#undef inet_addr
+#define inet_addr(cp) __inet_addr_WB(SocketBase, (cp))
+#undef inet_aton
+#define inet_aton(cp, addr) __inet_aton_WB(SocketBase, (CONST_STRPTR) (cp), (addr))
+#undef inet_ntoa
+#define inet_ntoa(in) ((char *) __Inet_NtoA_WB(SocketBase, (in).s_addr))
+#undef inet_pton
+#define inet_pton(af, src, dst) __inet_pton_WB(SocketBase, (af), (src), (dst))
+#undef inet_ntop
+#define inet_ntop(af, src, dst, size) ((const char *) __inet_ntop_WB(SocketBase, (af), (void *) (src), (dst), (size)))
+#undef gai_strerror
+#define gai_strerror(code) ((const char *) __gai_strerror_WB(SocketBase, (code)))
+
+#undef errno
+#define errno (*love_aros_socket_errno())
+#undef h_errno
+#define h_errno (*love_aros_socket_herrno())
+
+#endif /* __AROS__ */
+
+#endif /* LOVE_AROS_SOCKET_H */
