 #include "common/config.h"
+
+#ifdef __AROS__
+/* A socket is not a C library descriptor on AROS: it is closed, set up and
+   waited for through bsdsocket.library. */
+#include "../../aros/aros_socket.h"
+
+static int
+enet_aros_ioctl (int socket, unsigned long request, int * value)
+{
+    long argument = * value;
+
+    return IoctlSocket (socket, request, (char *) & argument);
+}
+
+#undef close
+#define close(socket) CloseSocket (socket)
+#undef select
+#define select(count, readSet, writeSet, exceptSet, timeout) WaitSelect (count, readSet, writeSet, exceptSet, timeout, NULL)
+#undef ioctl
+#define ioctl(socket, request, value) enet_aros_ioctl (socket, request, value)
+#endif
+
 #ifndef HAS_SOCKLEN_T
 typedef int socklen_t;
 #endif
@@ -68,6 +113,12 @@ static enet_uint32 timeBase = 0;
 int
 enet_initialize (void)
 {
+#ifdef __AROS__
+    /* No network stack running. */
+    if (love_aros_socket_base () == NULL)
+      return -1;
+#endif
+
     return 0;
 }
 
diff --git a/src/libraries/luasocket/libluasocket/usocket.c b/src/libraries/luasocket/libluasocket/usocket.c
