@@ -14,6 +14,18 @@
 #include <string.h>
 #include <signal.h>
 
+#ifdef __AROS__
+/* A socket is not a C library descriptor on AROS: it is closed, read,
+   written and waited for through bsdsocket.library. */
+#undef close
+#define close(s) CloseSocket(s)
+#undef select
+#define select(n, r, w, e, t) WaitSelect(n, r, w, e, t, NULL)
+#define read(s, b, n) recv(s, b, n, 0)
+#define write(s, b, n) send(s, b, n, 0)
+#define hstrerror(e) "host lookup failed"
+#endif
+
 /*-------------------------------------------------------------------------*\
 * Wait for readable/writable/connected socket with timeout
 \*-------------------------------------------------------------------------*/
@@ -78,8 +90,13 @@ int socket_waitfd(p_socket ps, int sw, p_timeout tm) {
 * Initializes module
 \*-------------------------------------------------------------------------*/
 int socket_open(void) {
+#ifdef __AROS__
+    /* No network stack running: the module cannot be used. */
+    if (!love_aros_socket_base()) return 0;
+#else
     /* installs a handler to ignore sigpipe or it will crash us */
     signal(SIGPIPE, SIG_IGN);
+#endif
     return 1;
 }
 
@@ -362,18 +379,28 @@ int socket_read(p_socket ps, char *data, size_t count, size_t *got, p_timeout tm
 * Put socket into blocking mode
 \*-------------------------------------------------------------------------*/
 void socket_setblocking(p_socket ps) {
+#ifdef __AROS__
+    long nonblocking = 0;
+    IoctlSocket(*ps, FIONBIO, (char *) &nonblocking);
+#else
     int flags = fcntl(*ps, F_GETFL, 0);
     flags &= (~(O_NONBLOCK));
     fcntl(*ps, F_SETFL, flags);
+#endif
 }
 
 /*-------------------------------------------------------------------------*\
 * Put socket into non-blocking mode
 \*-------------------------------------------------------------------------*/
 void socket_setnonblocking(p_socket ps) {
+#ifdef __AROS__
+    long nonblocking = 1;
+    IoctlSocket(*ps, FIONBIO, (char *) &nonblocking);
+#else
     int flags = fcntl(*ps, F_GETFL, 0);
     flags |= O_NONBLOCK;
     fcntl(*ps, F_SETFL, flags);
+#endif
 }
 
