id              = "love"
version         = "@VERSION@"
revision        = @REVISION@
summary         = "LOVE (love2d): runs 2D games written in Lua for the LOVE framework"
category        = "game/misc"
license         = "Zlib"
kind            = "app"
arch            = "@ARCH@"
abi             = "@ABI@"
subdir          = "LOVE"
icon            = "LOVE.info"
depends         = []
depends_checked = true
post_install_notes = [
  "Double-click the love icon and choose a game (.love file or drawer with main.lua), or from a Shell: Run love <game>.",
  "love --icon <game> writes an icon that starts the game with a double click.",
  "Saved games are kept in the Saves drawer of the package drawer.",
]
